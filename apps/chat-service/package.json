{
  "name": "chat-service",
  "version": "0.1.0",
  "private": true,
  "description": "Chat Service: chats, membership, ordered message history and real-time delivery across instances. NestJS + GraphQL subscriptions + Prisma/PostgreSQL + Redis pub/sub.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "test:int": "jest --config jest.int.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/terminus": "11.1.1",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "graphql": "16.14.2",
    "graphql-redis-subscriptions": "2.7.0",
    "graphql-subscriptions": "3.0.0",
    "graphql-ws": "5.16.2",
    "ioredis": "5.11.1",
    "joi": "18.3.1",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@testcontainers/postgresql": "10.28.0",
    "@testcontainers/redis": "10.28.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "ws": "8.22.1"
  }
}
