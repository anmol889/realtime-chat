{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "React + Apollo frontend: join chats, see history, send/receive messages live.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:int": "echo \"(web has no integration tests; see e2e/)\""
  },
  "dependencies": {
    "@apollo/client": "3.14.1",
    "graphql": "16.14.2",
    "graphql-ws": "5.16.2",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "^3.2.0"
  }
}
